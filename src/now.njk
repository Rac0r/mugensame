---
layout: base.njk
title: Now
description: What I'm doing at the moment.
permalink: /now/
---
<section class="prose-page">
  <p class="eyebrow">Current heading</p>
  <h1>Now</h1>

  {% if now.status %}
    <p>{{ now.status.text | escape }}</p>
    <p class="eyebrow">Updated {{ now.status.updatedAt | readableDate }}</p>
  {% else %}
    <p>Status unavailable.</p>
  {% endif %}
</section>

<section class="latest">
  <p class="eyebrow">Recently pushed</p>
  {% if now.repos | length %}
  <div class="post-list">
    {%- for repo in now.repos -%}
    <details class="contact-card repo-card">
      <summary>
        <span class="ping" aria-hidden="true"></span>
        <div>
          <h2>{{ repo.name | escape }}</h2>
          <p class="meta">{{ repo.pushedAt | readableDate }}</p>
          {% if repo.description %}<p class="excerpt">{{ repo.description | escape }}</p>{% endif %}
        </div>
        <span class="chevron" aria-hidden="true">▸</span>
      </summary>
      <div class="commit">
        {% if repo.commit %}
        <p class="commit-message">{{ repo.commit.message | escape }}</p>
        <ul class="commit-files">
          {%- for file in repo.commit.files %}
          <li><span class="file-name">{{ file.filename | escape }}</span><span class="added">+{{ file.additions }}</span><span class="removed">−{{ file.deletions }}</span></li>
          {%- endfor %}
        </ul>
        {% if repo.commit.moreFiles > 0 %}<p class="more-files">+{{ repo.commit.moreFiles }} more files</p>{% endif %}
        <a class="commit-link" href="{{ repo.commit.url | escape }}">Open on GitHub ↗</a>
        {% else %}
        <p class="more-files">Commit details unavailable</p>
        <a class="commit-link" href="{{ repo.url | escape }}">Open on GitHub ↗</a>
        {% endif %}
      </div>
    </details>
    {%- endfor -%}
  </div>
  {% else %}
  <p>Repository activity unavailable.</p>
  {% endif %}
</section>

<section class="latest">
  <p class="eyebrow">Latest field notes</p>
  {% if now.posts | length %}
  <div class="post-list">
    {%- for post in now.posts -%}
    <article class="contact-card">
      <a href="{{ post.url | escape }}">
        <span class="ping" aria-hidden="true"></span>
        <div>
          <h2>{{ post.title | escape }}</h2>
          <p class="meta">{{ post.date | readableDate }}</p>
        </div>
      </a>
    </article>
    {%- endfor -%}
  </div>
  {% else %}
  <p>Posts unavailable.</p>
  {% endif %}

  {% if now.generatedAt %}<p class="eyebrow">Collected {{ now.generatedAt | readableDate }}</p>{% endif %}
</section>
